{
  "_comment": "星塔旅人反和谐包 · 分发配置。玩家不需要改这个文件。",
  "_comment2": "你（发布者）只需要在每次更新游戏版本时改 repo 和 manifest 地址。",

  "repo": "stephen0128123-coder/xtlr-uncensor",

  "manifest_url": "https://github.com/stephen0128123-coder/xtlr-uncensor/releases/latest/download/manifest.json",

  "mirror_prefixes": [
    "",
    "https://ghfast.top/",
    "https://ghproxy.net/",
    "https://gh-proxy.com/"
  ],

  "_mirror_note": "空字符串代表直连 GitHub。安装器按顺序尝试，第一个成功即用。全部通道 2026-10-09 实测可用；gh-proxy.com 不支持断点续传（放末位，仅作兜底）。",

  "download": {
    "threads": 4,
    "retry": 4,
    "timeout_sec": 60,
    "retry_delay_sec": 2,
    "chunk_size_kb": 1024,
    "resume": true
  },

  "cache_dir": "%TEMP%\\xtlr_uncensor_cache",

  "verify": {
    "check_md5": true,
    "check_size": true,
    "strict": true
  }
}
